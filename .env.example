# رابط الموقع العام (يُستخدم في الروابط القانونية canonical وخريطة الموقع ووسوم OG)
SITE_URL=https://example.com

# عنوان PostgreSQL — من Supabase: استخدم Session Pooler (المنفذ 5432)
# مثال الشكل: postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
# محلياً مع Docker: postgresql://postgres:[password]@localhost:55432/postgres
DATABASE_URL=

# اتركه فارغاً أو فعّله مع Supabase؛ عيّنه false فقط لقاعدة PostgreSQL محلية بلا TLS
# ملاحظة: وجود ?sslmode=require في DATABASE_URL صحيح ومتوقع
# DATABASE_SSL=false

# شهادة CA بصيغة PEM — إلزامية مع Supabase لأن سلسلتها موقّعة بجذر خاص (Supabase Root 2021 CA)
# Project Settings → Database → SSL → Download certificate
# التحقق من سلسلة الشهادات مفعّل دائمًا؛ بدون هذه الشهادة يفشل الاتصال بخطأ SELF_SIGNED_CERT_IN_CHAIN
# (ضع المحتوى على سطر واحد مع \n بدل فواصل الأسطر)
# DATABASE_CA_CERT=

# إعدادات Supabase Storage (إجبارية في الإنتاج لتخزين صور الأخبار)
SUPABASE_URL=https://[project].supabase.co
# مفتاح خدمة سري — للخادم فقط، لا تستخدمه أبداً مع بادئة NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=article-images

# كلمة مرور حسابات النسخة التجريبية (تُستخدم فقط في scripts/seed.mjs — 12 حرفاً على الأقل)
ADMIN_PASSWORD=

# في الإنتاج: عيّن NODE_ENV=production لتفعيل HSTS وملفات تعريف الارتباط الآمنة (secure cookies)
# NODE_ENV=production
